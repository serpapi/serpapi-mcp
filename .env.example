# SerpApi MCP Server Configuration

# MCP Server Configuration
# Host to bind the server to (default: 0.0.0.0)
MCP_HOST=0.0.0.0

# Port to run the server on (default: 8000)
MCP_PORT=8000

# Public origin (scheme + host + optional port, no path) behind a reverse proxy.
# Leave unset for direct connections, which use the request's scheme and host.
# MCP_PUBLIC_ORIGIN=https://mcp.example.com

# OAuth introspection is enabled when both client credentials are set.
# MCP_OAUTH_AUTHORIZATION_SERVER=https://serpapi.com
# MCP_OAUTH_INTROSPECTION_URL=https://serpapi.com/oauth/introspect
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=

# How long (seconds) a resolved bearer token/api_key is cached before
# introspection/Account API is re-checked (default: 60)
# MCP_BEARER_AUTH_CACHE_TTL=60
